# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Tooling caches
.ruff_cache/
.pytest_cache/

# macOS
.DS_Store

# Local agent instructions and working notes — not published
AGENTS.md
CLAUDE.md
.claude/
docs/
plans/

# Raw captures: large, and phone photos carry EXIF GPS. Ignoring the whole tree
# rather than named subfolders, because a folder that moves must not silently
# lose its cover. Test fixtures under tests/fixtures/ are downscaled and
# metadata-stripped, and are committed.
images/

# Pipeline outputs, regenerated by a run.
results/

# Credentials — the PAT lives outside this repo. These patterns are a backstop
# against an accidental in-repo copy, not permission to make one: GitHub secret
# scanning revokes any PAT that reaches a pushed file.
*token*.txt
*.token
.env
.env.*
secrets/
